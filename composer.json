{
    "name": "bannerstop/mention-api-client-laravel",
    "description": "Laravel integration of bannerstop/mention-api-client: configuration, a container-bound client and facade for the mention-api /v2 interface and the generator for typed wrappers as an Artisan command",
    "type": "library",
    "keywords": [
        "mention",
        "api-client",
        "laravel",
        "psr-18",
        "openapi"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "bannerstop GmbH",
            "homepage": "https://www.bannerstop.com"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "bannerstop/mention-api-client": "dev-feature/generator as 1.0.x-dev",
        "guzzlehttp/guzzle": "^7.2",
        "illuminate/console": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "nyholm/psr7": "^1.8.2"
    },
    "require-dev": {
        "orchestra/testbench": "^6.10 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Bannerstop\\MentionApiLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bannerstop\\MentionApiLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bannerstop\\MentionApiLaravel\\MentionApiServiceProvider"
            ],
            "aliases": {
                "MentionApi": "Bannerstop\\MentionApiLaravel\\Facades\\MentionApi"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bannerstop/mention-api-client",
            "no-api": true
        }
    ]
}
